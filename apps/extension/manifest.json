{
  "manifest_version": 3,
  "name": "Sillonero",
  "version": "0.1.0",
  "description": "Deja que la app del celu vea tus pestañas, tus marcadores y la cola de YouTube, y maneje el video o audio de cualquier página. Solo habla con el programa de tu PC; no manda nada a internet.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "tabs",
    "bookmarks",
    "scripting",
    "sessions",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
